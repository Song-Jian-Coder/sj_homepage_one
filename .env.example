# 申万行业资金流看板 · ETL 配置模板
# 复制为 .env 并填入真实值；.env 不入库（gitignore）

# ── 数据源（Tushare 兼容代理）──
TS_ENDPOINT=http://221.204.19.233:7172
# token 优先取 TS_TOKEN；未设置则从 TS_TOKEN_FILE 读取
# TS_TOKEN=
TS_TOKEN_FILE=C:\path\to\jsdata_tk.csv

# ── MySQL ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_data

# ── 采集范围 ──
# 资金流回溯的交易日数量（默认 40 个交易日）
MONEYFLOW_DAYS=40
