# 申万行业资金流看板 · ETL 配置模板
# 复制为 backend/.env 并填入真实值；.env 不入库（gitignore）

# ── 数据源（Tushare 兼容代理）──
TS_ENDPOINT=http://221.204.19.233:7172
# token 优先取 TS_TOKEN；未设置则从 TS_TOKEN_FILE 读取
# TS_TOKEN=
TS_TOKEN_FILE=C:\path\to\jsdata_tk.csv

# ── MySQL ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_data
# 连接池与超时（API 用；原先每请求新建连接且无 timeout，DB 亚健康会拖垮服务）
DB_POOL_SIZE=8
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=20
DB_WRITE_TIMEOUT=20
# 会话时区：trade_date 的语义是 Asia/Shanghai，必须与进程时区一致
DB_TIME_ZONE=+08:00
TZ_OFFSET_HOURS=8

# ── 采集范围 ──
# 资金流主窗口交易日数量（代码默认 40；本机实际用 242 ≈ 一年）
MONEYFLOW_DAYS=242
# 单页行数（= 数据源实测硬顶 6000，勿调大）
MONEYFLOW_MAX_ROWS=6000
# 空洞回填单轮上限
MONEYFLOW_GAP_MAX_DAYS=50
# ETL 日志文件（留空 = backend/etl_run.log）
# LOG_FILE=

# ── API ──
# API 访问日志（留空 = backend/api_run.log）
# API_LOG_FILE=
# 聚合类接口的进程内 TTL 缓存秒数；0 = 关闭
API_CACHE_TTL=60
# CORS 白名单（逗号分隔）；前端与 API 同源时不需要放宽
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── 管理接口 ──
# 留空或等于 change-me-admin-key 时，/api/v1/admin/* 一律拒绝（fail closed）
ADMIN_KEY=
# IP 白名单（逗号分隔）；留空 = 不限制
ADMIN_IP_ALLOWLIST=
# 管理接口限流（次/分钟/IP）
ADMIN_RATE_LIMIT_PER_MIN=30
# 审计表里超过该时长的 running 行视为崩溃残留（分钟）
FETCH_STALE_MINUTES=360
